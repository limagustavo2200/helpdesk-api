SECURITY_ENABLED=true
SWAGGER_ENABLED=true

AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_REDIRECT_URI=https://your-api-domain.com/auth-microsoft/callback

API_EMAIL_SERVICE_URL=https://your-email-service-url/v1/emails/send
API_EMAIL_SERVICE_SECRET=your-email-service-secret

API_TEAMS_WEBHOOK_URL=https://your-tenant.webhook.office.com/webhookb2/...

DB_USERNAME=your-database-username
DB_PASSWORD=your-database-password

JWT_SECRET_KEY=your-jwt-secret-key-min-64-chars

FRONTEND_URL=https://your-frontend-domain.com
